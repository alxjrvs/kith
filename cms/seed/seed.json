{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Kith",
    "description": "Every word on kith.town: games, characters, knowledge pages, links and the site's own copy",
    "author": "alxjrvs"
  },
  "settings": {
    "title": "Kith",
    "tagline": "Your games, your table, your people."
  },
  "collections": [
    {
      "slug": "games",
      "label": "Games",
      "labelSingular": "Game",
      "sortOrder": 1,
      "description": "One entry per game: a campaign or a board game. Publishing a new one creates it in Kith; its slug is its address, kith.town/games/<slug>. Schedule, quorum and Discord channel are set in Kith's Organise pages.",
      "urlPattern": "/games/{slug}",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "category",
          "label": "What it is",
          "type": "select",
          "required": true,
          "defaultValue": "campaign",
          "validation": {
            "options": [
              "campaign",
              "board_game"
            ]
          }
        },
        {
          "slug": "system",
          "label": "System",
          "type": "select",
          "validation": {
            "options": [
              "D&D",
              "Daggerheart",
              "Root RPG",
              "Salvage Union",
              "Mothership",
              "Other"
            ]
          }
        },
        {
          "slug": "tagline",
          "label": "Tagline (the line under the name)",
          "type": "string"
        },
        {
          "slug": "summary",
          "label": "Summary (one or two lines, for its card on Games)",
          "type": "text"
        },
        {
          "slug": "pitch",
          "label": "Pitch (the home base's longer description)",
          "type": "portableText"
        },
        {
          "slug": "hero",
          "label": "Hero image",
          "type": "image"
        },
        {
          "slug": "cover",
          "label": "Cover or logo (a board game's box, a campaign's logo)",
          "type": "image"
        },
        {
          "slug": "sound",
          "label": "Sound (plays from the splash page's button)",
          "type": "file"
        },
        {
          "slug": "visibility",
          "label": "Who can see it, when Kith first creates it (members: the people on the game; organisers: only organisers). Change it later in Organise.",
          "type": "select",
          "required": true,
          "defaultValue": "members",
          "validation": {
            "options": [
              "members",
              "public",
              "organisers"
            ]
          }
        }
      ]
    },
    {
      "slug": "characters",
      "label": "Characters",
      "labelSingular": "Character",
      "sortOrder": 2,
      "description": "Who each player is playing, per game. They appear on the game's roster beside the player.",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "name",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "game",
          "label": "Game (its slug, e.g. hollowmere)",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "player",
          "label": "Player (their Discord username, or their Discord user id, which survives a rename)",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "sheet",
          "label": "Character sheet link",
          "type": "url"
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Knowledge pages",
      "labelSingular": "Knowledge page",
      "sortOrder": 3,
      "description": "A game's knowledge pages: house rules, setting notes, session zero. Shown at kith.town/games/<game>/<slug>.",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "game",
          "label": "Game (its slug)",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "order",
          "label": "Order (1 is first)",
          "type": "integer"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText"
        },
        {
          "slug": "visibility",
          "label": "Who can see it (members: the people on the game; organisers: only organisers)",
          "type": "select",
          "required": true,
          "defaultValue": "members",
          "validation": {
            "options": [
              "members",
              "public",
              "organisers"
            ]
          }
        }
      ]
    },
    {
      "slug": "links",
      "label": "Links",
      "labelSingular": "Link",
      "sortOrder": 4,
      "description": "A game's links: the VTT, the rules, a shared doc.",
      "supports": [
        "drafts"
      ],
      "fields": [
        {
          "slug": "label",
          "label": "Label",
          "type": "string",
          "required": true
        },
        {
          "slug": "url",
          "label": "URL",
          "type": "url",
          "required": true
        },
        {
          "slug": "game",
          "label": "Game (its slug)",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "kind",
          "label": "Kind",
          "type": "select",
          "required": true,
          "defaultValue": "other",
          "validation": {
            "options": [
              "vtt",
              "sheet",
              "rules",
              "doc",
              "discord",
              "other"
            ]
          }
        },
        {
          "slug": "order",
          "label": "Order (1 is first)",
          "type": "integer"
        },
        {
          "slug": "visibility",
          "label": "Who can see it (members: the people on the game; organisers: only organisers)",
          "type": "select",
          "required": true,
          "defaultValue": "members",
          "validation": {
            "options": [
              "members",
              "public",
              "organisers"
            ]
          }
        }
      ]
    },
    {
      "slug": "sections",
      "label": "Site copy",
      "labelSingular": "Section",
      "sortOrder": 5,
      "description": "The site's own words, by slug: home (the front page's heading, kicker and line) and games (the Games hub's heading and line). A missing one falls back to the site's built-in words.",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Heading",
          "type": "string",
          "required": true
        },
        {
          "slug": "kicker",
          "label": "Kicker (the small line above the heading)",
          "type": "string"
        },
        {
          "slug": "body",
          "label": "Body",
          "type": "portableText"
        }
      ]
    }
  ],
  "content": {
    "sections": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "Every game we run, in one place.",
          "kicker": "The Orrey of Worlds",
          "body": [
            {
              "_type": "block",
              "_key": "b1",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s1",
                  "text": "Each game has a home base: who plays whom, when it meets next, its links and what the table knows.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
        "id": "games",
        "slug": "games",
        "status": "published",
        "data": {
          "title": "Games",
          "body": [
            {
              "_type": "block",
              "_key": "b1",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s1",
                  "text": "Every table we run. Each one has a home base with who plays whom and when it meets next.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
        "id": "conduct",
        "slug": "conduct",
        "status": "published",
        "data": {
          "title": "The rules",
          "body": [
            {
              "_type": "block",
              "_key": "r00",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r00s",
                  "text": "1. Respect the game",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r01",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r01s",
                  "text": "It is a privilege to come together and play games like this. Take everyone as they are, and interact with the story we are telling collectively. Lean in. Dork out. Bring your shit. Let's get weird.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r10",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r10s",
                  "text": "2. Respect each other's time",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r11",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r11s",
                  "text": "We get precious few opportunities to spend time with each other. Needing to step away for a day, from a game, running late, had a tough one, etc. All human. Just let us know ASAP rather than letting guilt linger.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r20",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r20s",
                  "text": "3. Give each other grace",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r21",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r21s",
                  "text": "It's all our first time being alive. We will make mistakes, we will annoy each other, and we may even hurt each other's feelings. This is the bargain we make when we want to play games that make us feel things. Keep it on the court, and remember that we are all friends.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r30",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r30s",
                  "text": "4. Don't be an asshole",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r31",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r31s",
                  "text": "Bigotry, harassment, continued patterns of breaking boundaries and agreed upon rules, and overall being an unpleasant games partner will get you un-invited and kicked out.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r40",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r40s",
                  "text": "5. Say if it sucks",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r41",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r41s",
                  "text": "This is fun make believe time. If we ever cross the line into real hurtful experiences, traumas, we stop and take some time. We have a universal stop sign button on every game's page in the app, and a suggestion box for private communication. I am always available to chat about anything.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r50",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r50s",
                  "text": "6. I'm God, fuck you",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "r51",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "r51s",
                  "text": "At the end of the day, this is my server, and I'll kick you out if you suck. I doubt I'll have to, but, live in fear.",
                  "marks": []
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
